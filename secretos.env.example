# Archivo de credenciales para Pela (Google OAuth y firma de sesiones)
# Copiá este archivo a `secretos.env` (está en .gitignore)
# o a `~/pela-data/secretos.env` en el servidor VPS.

# Credenciales obtenidas de Google Cloud Console (OAuth 2.0 Client IDs):
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Clave secreta para firmar cookies HMAC (string aleatorio de al menos 32 caracteres):
SESSION_SECRET=cambiar_por_un_string_largo_y_seguro_para_firmar_cookies_123456

# URL base de la app (http://localhost:3000 o http://localhost:9314 en local, https://pela.signai.ar en producción):
APP_URL=http://localhost:3000
